# The web app's settings. Copy this file to .env.local and fill it in; never commit the copy.
# Every value here is public (spec §13.3). Anything secret belongs in an Edge Function.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# on or off (spec §14.1); off until an Apple Developer team is available
APPLE_SIGN_IN=
