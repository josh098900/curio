# The web app's settings. Copy this file to .env.local and fill it in; never commit the copy.
# Every value here is public (spec §13.3). Anything secret belongs in an Edge Function.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_SENTRY_DSN=
# Sentry's build step names the project its source maps go to (spec §14.3). Its upload token,
# SENTRY_AUTH_TOKEN, is a secret, set only in Vercel's Production environment, as a Sensitive
# variable (spec §13.3).
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# on or off (spec §14.1); off until an Apple Developer team is available
APPLE_SIGN_IN=
